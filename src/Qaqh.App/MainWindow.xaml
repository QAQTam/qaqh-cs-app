<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Qaqh_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Qaqh_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="QAQ Harness"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!--  会话项右键菜单：由 SessionList 的项共享  -->
            <MenuFlyout x:Key="SessionFlyout">
                <MenuFlyoutItem Click="SessionRename_Click" Text="重命名" />
                <MenuFlyoutItem Click="SessionArchive_Click" Text="归档" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Click="SessionDelete_Click" Text="删除">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="QAQ Harness"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="300"
            SelectionChanged="NavView_SelectionChanged">

            <!--  会话区：置顶于导航项之上  -->
            <NavigationView.PaneCustomContent>
                <Grid
                    Height="380"
                    Margin="0,8,0,0"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,0,16,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="WorkspacePicker"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind Vm.Workspaces, Mode=OneWay}"
                            SelectedItem="{x:Bind Vm.SelectedWorkspace, Mode=TwoWay}"
                            SelectionChanged="WorkspacePicker_SelectionChanged" />
                        <Button
                            Grid.Column="1"
                            Padding="6,4"
                            Click="NewWorkspaceButton_Click"
                            Content="&#xE710;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            ToolTipService.ToolTip="新建工作区" />
                    </Grid>

                    <Button
                        Grid.Row="1"
                        Margin="16,0,16,0"
                        HorizontalAlignment="Stretch"
                        Click="NewSessionButton_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="新会话" />
                        </StackPanel>
                    </Button>

                    <ListView
                        x:Name="SessionList"
                        Grid.Row="2"
                        Margin="8,0,8,0"
                        ItemsSource="{x:Bind Vm.Sessions, Mode=OneWay}"
                        SelectionMode="Single"
                        SelectionChanged="SessionList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SessionItemVm">
                                <Grid
                                    Height="44"
                                    Background="Transparent"
                                    ContextFlyout="{StaticResource SessionFlyout}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Margin="4,0,8,0"
                                        FontSize="14"
                                        Glyph="{x:Bind local:UiMap.SessionGlyph(ActivityState), Mode=OneWay}"
                                        Foreground="{x:Bind local:UiMap.SessionBrush(ActivityState), Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="8,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind local:UiMap.SessionStateText(ActivityState), Mode=OneWay}" />

                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="首页"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="技能" Tag="skills">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设备与配对" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="文件" Tag="files">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="诊断" Tag="diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border
                    Margin="12,8,12,12"
                    Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{x:Bind Vm.ConnectionBrush, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind Vm.ConnectionText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="ConnectionRetryButton"
                            Grid.Column="2"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ConnectionRetryButton_Click"
                            Content="&#xE72C;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12"
                            ToolTipService.ToolTip="重连 daemon" />
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
