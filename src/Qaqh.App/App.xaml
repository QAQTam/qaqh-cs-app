<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Qaqh_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Qaqh_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--  应用级语义资源：按用途命名，不用色值字面量  -->
            <Thickness x:Key="PagePadding">24,16,24,16</Thickness>
            <x:Double x:Key="SessionRailItemHeight">52</x:Double>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="CodeInlineBackgroundBrush" Color="#0F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="CodeInlineBackgroundBrush" Color="#1AFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CodeInlineBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
