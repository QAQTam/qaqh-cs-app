<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qaqh_App.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Qaqh_App"
    xmlns:md="using:Qaqh_App.Controls.Markdown"
    xmlns:pages="using:Qaqh_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  用户消息  -->
        <DataTemplate x:Key="UserTemplate" x:DataType="local:ChatUserVm">
            <Grid Margin="24,8,24,8" HorizontalAlignment="Right">
                <Border
                    MaxWidth="640"
                    Padding="12,8"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <TextBlock
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <!--  助手输出（reasoning 折叠 / answer markdown）  -->
        <DataTemplate x:Key="AssistantTemplate" x:DataType="local:ChatAssistantVm">
            <StackPanel Margin="24,4,24,4" MaxWidth="820" HorizontalAlignment="Left">
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    IsExpanded="False"
                    Visibility="{x:Bind local:ChatUi.VisibleIf(IsReasoning), Mode=OneWay}">
                    <Expander.Header>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="思考过程" />
                    </Expander.Header>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Expander>
                <md:MarkdownView Text="{x:Bind Text, Mode=OneWay}" Visibility="{x:Bind local:ChatUi.VisibleIfNot(IsReasoning), Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <!--  工具卡片  -->
        <DataTemplate x:Key="ToolTemplate" x:DataType="local:ChatToolVm">
            <Border
                Margin="24,4,24,4"
                MaxWidth="820"
                Padding="10,8"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE943;" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ToolName, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind StateText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        MaxLines="3"
                        Text="{x:Bind ArgsSummary, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind local:ChatUi.VisibleIfNotEmpty(ArgsSummary), Mode=OneWay}" />
                    <Border
                        Padding="8,6"
                        Background="{ThemeResource CodeBlockBackgroundBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind local:ChatUi.VisibleIfNotEmpty(OutputTail), Mode=OneWay}">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11.5"
                            IsTextSelectionEnabled="True"
                            MaxLines="8"
                            Text="{x:Bind OutputTail, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  审批卡片  -->
        <DataTemplate x:Key="ApprovalTemplate" x:DataType="local:ChatApprovalVm">
            <Border
                Margin="24,6,24,6"
                MaxWidth="820"
                Padding="12,10"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                            Glyph="&#xE7BA;" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind local:ChatUi.ApprovalTitle(Kind), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind RequestText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <!--  权限审批  -->
                    <StackPanel Spacing="6" Visibility="{x:Bind local:ChatUi.VisibleIf(IsPermission), Mode=OneWay}">
                        <CheckBox Content="信任此文件夹（后续同目录操作不再询问）" IsChecked="{x:Bind TrustFolder, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="ApprovalAllow_Click"
                                Content="批准"
                                Style="{ThemeResource AccentButtonStyle}" />
                            <Button Click="ApprovalDeny_Click" Content="拒绝" />
                        </StackPanel>
                    </StackPanel>

                    <!--  计划评审面板已摘除：LTS 契约删除了 plan-review 交互类型（只剩 ask|permission）；
                          计划面走 plan.read + plan.action（条目级），重设计后再接回。  -->

                    <!--  Ask 问答  -->
                    <StackPanel Spacing="6" Visibility="{x:Bind local:ChatUi.VisibleIf(IsAsk), Mode=OneWay}">
                        <TextBox x:Name="AskAnswerBox" PlaceholderText="输入回答…" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="AskAnswer_Click"
                                Content="回答"
                                Style="{ThemeResource AccentButtonStyle}" />
                            <Button Click="AskDismiss_Click" Content="忽略" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  exec 终端卡  -->
        <DataTemplate x:Key="ExecTemplate" x:DataType="local:ChatExecVm">
            <Border
                Margin="24,4,24,4"
                MaxWidth="820"
                Padding="10,8"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE756;" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Text="{x:Bind Command, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StateText, Mode=OneWay}" />
                    </StackPanel>
                    <Border
                        MaxHeight="220"
                        Padding="8,6"
                        Background="{ThemeResource CodeBlockBackgroundBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind local:ChatUi.VisibleIfNotEmpty(OutputTail), Mode=OneWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11.5"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind OutputTail, Mode=OneWay}"
                                TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:ChatUi.VisibleIf(IsRunning), Mode=OneWay}">
                        <Button Click="ExecInterrupt_Click" Content="中断" />
                        <Button Click="ExecTerminate_Click" Content="终止" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  子代理卡  -->
        <DataTemplate x:Key="SubagentTemplate" x:DataType="local:ChatSubagentVm">
            <Border
                Margin="24,4,24,4"
                MaxWidth="820"
                Padding="10,8"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE99A;" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Role, Mode=OneWay}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        MaxLines="4"
                        Text="{x:Bind ResultText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:ChatUi.VisibleIfNotEmpty(ResultText), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  分隔线  -->
        <DataTemplate x:Key="DividerTemplate" x:DataType="local:ChatDividerVm">
            <StackPanel Margin="24,8" Orientation="Horizontal" Spacing="8">
                <Rectangle
                    Height="1"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Text}" />
            </StackPanel>
        </DataTemplate>

        <pages:ChatTemplateSelector
            x:Key="ChatSelector"
            Approval="{StaticResource ApprovalTemplate}"
            Exec="{StaticResource ExecTemplate}"
            Subagent="{StaticResource SubagentTemplate}"
            Assistant="{StaticResource AssistantTemplate}"
            Divider="{StaticResource DividerTemplate}"
            Tool="{StaticResource ToolTemplate}"
            User="{StaticResource UserTemplate}" />
    </Page.Resources>

    <Grid Padding="8,8,8,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  会话头  -->
        <Grid ColumnSpacing="12" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Session.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Session.Model, Mode=OneWay}" />
            </StackPanel>
            <FontIcon
                Grid.Column="1"
                FontSize="14"
                Glyph="{x:Bind local:UiMap.SessionGlyph(Session.ActivityState), Mode=OneWay}"
                Foreground="{x:Bind local:UiMap.SessionBrush(Session.ActivityState), Mode=OneWay}" />
        </Grid>

        <!--  审批待办提示  -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0,16,0"
            HorizontalAlignment="Left"
            IsClosable="False"
            IsOpen="{x:Bind Chat.HasPendingApproval, Mode=OneWay}"
            IsIconVisible="True"
            Severity="Warning"
            Title="有待响应的请求"
            Message="展开聊天流中的高亮卡片进行响应。" />

        <!--  聊天流  -->
        <ListView
            x:Name="StreamList"
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemTemplateSelector="{StaticResource ChatSelector}"
            ItemsSource="{x:Bind Chat.Items, Mode=OneWay}"
            SelectionMode="None" />

        <!--  任务面板  -->
        <Expander
            Grid.Row="2"
            Margin="16,0,16,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Todos.Summary, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        Padding="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TodoRefresh_Click"
                        Content="&#xE72C;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Grid>
            </Expander.Header>
            <ListView ItemsSource="{x:Bind Todos.Items, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TodoItemPanelVm">
                        <Grid Height="36" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="13"
                                Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="2"
                                Padding="4"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="TodoCancel_Click"
                                Content="&#xE711;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>

        <!--  团队面板  -->
        <Expander
            Grid.Row="3"
            Margin="16,0,16,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Team.Summary, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        Padding="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TeamRefresh_Click"
                        Content="&#xE72C;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Grid>
            </Expander.Header>
            <ListView ItemsSource="{x:Bind Team.Agents, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TeamAgentRowVm">
                        <Grid Height="36" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Text="{x:Bind AgentPath}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Nickname}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Status}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>

        <!--  输入区  -->
        <Grid Grid.Row="4" Margin="16,0,16,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InputBox"
                KeyDown="InputBox_KeyDown"
                PlaceholderText="发送消息…（Enter 发送）"
                Text="{x:Bind Vm.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                Click="Send_Click"
                Content="发送"
                Style="{ThemeResource AccentButtonStyle}" />
            <Button Grid.Column="2" Click="Cancel_Click" Content="取消" />
        </Grid>
    </Grid>
</Page>
