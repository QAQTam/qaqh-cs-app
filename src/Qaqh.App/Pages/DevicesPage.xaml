<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Qaqh_App.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Qaqh_App"
    xmlns:pages="using:Qaqh_App.Pages"
    xmlns:contract="using:Qaqh.Sdk.Contract"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设备与配对" />
        <Border
            Grid.Row="1"
            Padding="16"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <StackPanel Spacing="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="配对新设备" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ScopePicker" SelectedIndex="1" MinWidth="140">
                            <ComboBoxItem Tag="view" Content="view · 只读" />
                            <ComboBoxItem Tag="interact" Content="interact · 可交互" />
                            <ComboBoxItem Tag="admin" Content="admin · 管理员" />
                        </ComboBox>
                        <Button Click="IssuePairing_Click" Content="签发配对令牌 + 二维码" Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                    <Image
                        Width="180"
                        Height="180"
                        HorizontalAlignment="Left"
                        Source="{x:Bind QrImage, Mode=OneWay}"
                        Visibility="{x:Bind HasQr, Mode=OneWay}" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11.5"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind PairingText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasQr, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="已配对设备" />
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StatusText, Mode=OneWay}" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind Devices, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="pages:DeviceRowVm">
                            <Grid Height="44" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Scope}" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="Revoke_Click" Content="吊销" Tag="{x:Bind DeviceId}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational"
                    Title="提示"
                    Message="配对令牌签发（QR）在后续版本开放；此处支持查看与吊销。" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
